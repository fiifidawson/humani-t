# Every setting the API reads. Copy to .env for local development, or run
# `python scripts/dev_secrets.py` from the repository root to generate one.
#
# Load it explicitly:  uv run --env-file .env uvicorn app.main:app --port 8731 --no-proxy-headers
# In production, provide secrets as Docker secrets (/run/secrets/humani_t_<name>,
# lower-case) rather than environment variables. Any HUMANI_T_ name that is not
# a setting below, as a variable or a secret file, stops the process at start.

# development | test | production
HUMANI_T_ENVIRONMENT=development

# The single origin the browser uses for both the SPA and the API.
HUMANI_T_PUBLIC_ORIGIN=https://localhost

# Runtime role: reads and writes rows only. Unset = in-memory storage.
HUMANI_T_DATABASE_URL=postgresql+asyncpg://humani_t_app:CHANGE_ME@127.0.0.1:55432/humani_t

# Schema-owner role: used only by `alembic upgrade head`.
HUMANI_T_MIGRATION_DATABASE_URL=postgresql+asyncpg://humani_t_migrator:CHANGE_ME@127.0.0.1:55432/humani_t

# Connection pool per API process: a hard limit, a short wait, then 503.
HUMANI_T_DB_POOL_SIZE=10
HUMANI_T_DB_POOL_TIMEOUT_SECONDS=5
# Postgres cancels any statement running longer than this (milliseconds).
HUMANI_T_DB_STATEMENT_TIMEOUT_MS=15000

# Key-encryption keys as `version:base64`, comma-separated. Generate one with
# `uv run python -m app.cli generate-kek`. Required whenever DATABASE_URL is set.
HUMANI_T_KEY_ENCRYPTION_KEYS=1:CHANGE_ME

# Shared rate limits across API workers. Unset = per-process (development only).
HUMANI_T_VALKEY_URL=redis://:CHANGE_ME@127.0.0.1:56379/0

# Outbound mail for invitations and password resets. In development, Mailpit
# from compose.yaml listens on 127.0.0.1:51025 (no auth, no TLS) and shows the
# messages at http://127.0.0.1:58025. Unset = mail is kept in memory.
HUMANI_T_SMTP_HOST=127.0.0.1
HUMANI_T_SMTP_PORT=51025
HUMANI_T_SMTP_USERNAME=
HUMANI_T_SMTP_PASSWORD=
HUMANI_T_SMTP_SENDER=humani-t <no-reply@localhost>
HUMANI_T_SMTP_STARTTLS=false

# The model server: Ollama, run by the operator. Compose default is the
# `ollama` service (http://ollama:11434); for `ollama serve` on this machine use
# http://127.0.0.1:11434. A remote server must use https in production, with a
# bearer token (Docker secret `inference_token`) if its proxy requires one.
HUMANI_T_INFERENCE_URL=http://127.0.0.1:11434
HUMANI_T_INFERENCE_MODEL=llama3.1:8b
HUMANI_T_INFERENCE_TOKEN=
# One model call, including loading the model into memory (seconds).
HUMANI_T_INFERENCE_TIMEOUT_SECONDS=300
# Hosted model APIs (OpenAI, Anthropic, Google, ollama.com, *-cloud models) are
# refused unless this is true. Turning it on sends masked text to a third party.
HUMANI_T_ALLOW_HOSTED_INFERENCE=false

# The local name-and-place detector for masking (spaCy, `uv sync --extra ner`).
# auto = use it when installed; spacy = refuse to start without it; off = patterns
# and project rules only. The model is loaded from this machine, never downloaded.
HUMANI_T_MASKING_NER=auto
HUMANI_T_MASKING_NER_MODEL=en_core_web_sm

# Uploaded documents (walkthrough 16). Files are stored sealed under each
# project's key in this directory (a volume in compose). Empty: in memory with
# in-memory storage; with a database, uploads stay off until it is set.
HUMANI_T_DOCUMENT_STORAGE_DIR=
# The largest file accepted, in bytes (20 MiB). Keep clamd's StreamMaxLength above it.
HUMANI_T_UPLOAD_MAX_BYTES=20971520
# Per-project quotas, and uploads one person may make per hour.
HUMANI_T_DOCUMENTS_PER_PROJECT=200
HUMANI_T_DOCUMENT_BYTES_PER_PROJECT=1073741824
HUMANI_T_UPLOADS_PER_HOUR=60
# Malware scanning of uploads: clamd (the operator's ClamAV daemon, inside the
# deployment: it receives the raw files) or none (skip, recorded on every
# document). Empty in production: uploads are refused.
HUMANI_T_MALWARE_SCANNER=
# tcp://clamav:3310 or unix:///run/clamav/clamd.sock; only with MALWARE_SCANNER=clamd.
HUMANI_T_CLAMD_ADDRESS=
# Reading a file: time limit, PDF pages and characters kept.
HUMANI_T_EXTRACTION_TIMEOUT_SECONDS=60
HUMANI_T_EXTRACTION_MAX_PAGES=500
HUMANI_T_EXTRACTION_MAX_CHARACTERS=2000000

# Paper sources to search, comma-separated: openalex, europepmc, arxiv.
# Empty = none (searches reach no external source).
HUMANI_T_PAPER_SOURCES=openalex,europepmc,arxiv
# How many papers Discover asks each source for (1 to 200).
HUMANI_T_PAPERS_PER_SOURCE=25
# How many papers Screen sends to the model at once. Keep it low on a CPU-only server.
HUMANI_T_SCREENING_CONCURRENCY=2
# How many Writer and Critic rounds the decision brief may take (1 to 10).
HUMANI_T_BRIEF_MAX_ROUNDS=3
# OpenAlex: a free API key (https://openalex.org/settings/api) raises the daily
# budget and rate limit; without one, all users behind this IP share $0.10/day.
# Docker secret `openalex_api_key` in production.
HUMANI_T_OPENALEX_API_KEY=
# Optional contact address sent to OpenAlex. It no longer changes rate limits.
HUMANI_T_OPENALEX_MAILTO=

# Reverse proxies whose X-Forwarded-For names the client, as comma-separated
# addresses or networks. Empty = trust none: the connecting address is the client,
# which is right when nothing sits in front of the API. Compose sets Caddy's.
HUMANI_T_TRUSTED_PROXIES=

# Work queued runs inside the API process: true, false, or empty for the default
# (on with in-memory storage, off with a database). Refused in production.
HUMANI_T_RUN_WORKER_IN_PROCESS=
# Development only, all refused in production. DEMO_INFERENCE answers every model
# call with canned answers made in this process (no model server needed); add `demo`
# to PAPER_SOURCES for made-up papers (no internet needed). DEV_ADMIN_* creates an
# administrator at start, with in-memory storage only.
HUMANI_T_DEMO_INFERENCE=false
HUMANI_T_DEV_ADMIN_EMAIL=
HUMANI_T_DEV_ADMIN_PASSWORD=

HUMANI_T_LOG_LEVEL=INFO
