# Every setting the API reads. Copy to .env for local development, or run
# `python scripts/dev_secrets.py` from the repository root to generate one.
#
# Load it explicitly:  uv run --env-file .env uvicorn app.main:app --port 8731
# In production, provide secrets as Docker secrets (/run/secrets/<name>,
# lower-case, without the HUMANI_T_ prefix) rather than environment variables.

# development | test | production
HUMANI_T_ENVIRONMENT=development

# The single origin the browser uses for both the SPA and the API.
HUMANI_T_PUBLIC_ORIGIN=https://localhost

# Runtime role: reads and writes rows only. Unset = in-memory storage.
HUMANI_T_DATABASE_URL=postgresql+asyncpg://humani_t_app:CHANGE_ME@127.0.0.1:55432/humani_t

# Schema-owner role: used only by `alembic upgrade head`.
HUMANI_T_MIGRATION_DATABASE_URL=postgresql+asyncpg://humani_t_migrator:CHANGE_ME@127.0.0.1:55432/humani_t

# Key-encryption keys as `version:base64`, comma-separated. Generate one with
# `uv run python -m app.cli generate-kek`. Required whenever DATABASE_URL is set.
HUMANI_T_KEY_ENCRYPTION_KEYS=1:CHANGE_ME

HUMANI_T_LOG_LEVEL=INFO
