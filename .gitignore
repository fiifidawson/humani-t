# ---------------------------------------------------------------------------
# humani-t
#
# Layout this file covers:
#   apps/        Vite + React (web)
#   services/api Python + uv + FastAPI
#
# Note: patterns are intentionally NOT anchored with a leading slash, so they
# match at every depth of the monorepo (e.g. apps/web/node_modules).
# ---------------------------------------------------------------------------

# --- Secrets and local environment -----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
# Docker secret files written by scripts/dev_secrets.py
secrets/

# --- Node / pnpm ------------------------------------------------------------
node_modules/
.pnpm-store/
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Lockfiles are committed on purpose. Do not ignore:
#   pnpm-lock.yaml, services/api/uv.lock

# --- Build output -----------------------------------------------------------
dist/
build/
out/
.turbo/
*.tsbuildinfo

# --- Test and coverage ------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Python / uv ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.Python
*.egg-info/
.eggs/

# Python tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/

# --- Local database files (never commit data) -------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal

# --- Editors and IDEs -------------------------------------------------------
.idea/
*.swp
*.swo
*~

# VS Code: ignore personal settings, keep the ones the team shares
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# --- Operating system -------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Local scratch ----------------------------------------------------------
*.local
.cache/
.vscode/settings.json
tmp/
