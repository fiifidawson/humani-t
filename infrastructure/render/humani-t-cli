#!/bin/bash
# Run an operator command (python -m app.cli …) from Render's Shell, with the same
# settings as the running app: `humani-t-cli create-admin --email … --password-stdin`.
set -euo pipefail
source /render/env.sh
unset MIGRATION_URL DB_MIGRATOR_PASSWORD PG_ADMIN_USER PG_ADMIN_PASSWORD
cd /app
exec setpriv --reuid=10001 --regid=10001 --clear-groups --no-new-privs -- \
	env HOME=/nonexistent python -m app.cli "$@"
