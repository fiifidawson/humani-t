# Settings for the self-hosted stack (compose.yaml). Copy to .env and edit:
#   copy .env.example .env        (PowerShell)
#   cp .env.example .env          (Linux, macOS)
#
# Docker Compose reads .env from this directory on its own. Nothing secret goes in
# this file: passwords, the KEK and connection URLs are files under ./secrets,
# created by `python infrastructure/generate_secrets.py`.
#
# This is not services/api/.env, which configures the API when it runs on the host
# during development (see scripts/dev_secrets.py).

# The public host name. Caddy gets a certificate for it from Let's Encrypt, which
# needs ports 80 and 443 reachable from the internet and a DNS record pointing
# here. Leave it as localhost to try the stack on one machine.
HUMANI_T_DOMAIN=localhost
# The exact origin browsers use: https:// plus the domain, plus the port if it is
# not 443. The API refuses writes whose Origin header differs.
HUMANI_T_PUBLIC_ORIGIN=https://localhost
HUMANI_T_HTTP_PORT=80
HUMANI_T_HTTPS_PORT=443

# Outgoing mail: invitations, password resets, security notices. Required.
# To try the stack locally, use the bundled Mailpit instead (inbox at
# http://127.0.0.1:8025): add local-mail to COMPOSE_PROFILES, and set
# HUMANI_T_SMTP_HOST=mailpit, HUMANI_T_SMTP_PORT=1025, HUMANI_T_SMTP_STARTTLS=false.
HUMANI_T_SMTP_HOST=smtp.example.org
HUMANI_T_SMTP_PORT=587
HUMANI_T_SMTP_USERNAME=
HUMANI_T_SMTP_SENDER=humani-t <no-reply@example.org>
HUMANI_T_SMTP_STARTTLS=true
# The SMTP password, if any, goes in ./secrets/smtp_password.

# The language model. The default is the bundled Ollama (add local-model to
# COMPOSE_PROFILES). To use a model server on another machine you control, see
# docs/deploy/remote-model.md; its bearer token goes in ./secrets/inference_token.
# Hosted model APIs (OpenAI, Anthropic, ollama.com...) are refused unless the
# operator changes compose.yaml: masked text would leave the deployment.
# ollama, or openai for a server that speaks OpenAI's Chat Completions API (vLLM,
# llama.cpp; or a hosted API once compose.yaml allows it). For openai, the URL is
# the base before /chat/completions, e.g. http://vllm:8000/v1.
HUMANI_T_INFERENCE_API=ollama
HUMANI_T_INFERENCE_URL=http://ollama:11434
HUMANI_T_INFERENCE_MODEL=llama3.1:8b
HUMANI_T_OLLAMA_MEMORY=8g
HUMANI_T_OLLAMA_CPUS=4

# Where papers are searched, comma-separated: openalex, europepmc, arxiv. Empty
# searches nothing outside the deployment. OpenAlex asks for a contact address;
# an OpenAlex API key, if you have one, goes in ./secrets/openalex_api_key.
HUMANI_T_PAPER_SOURCES=

# Country and large-region names (Mali, the Sahel) in questions and plans: true
# masks them like any place; false keeps them so the search and criteria keep the
# review's geography. Towns, districts and camps are masked either way (ADR 0011).
HUMANI_T_MASK_COUNTRIES_AND_REGIONS=true
HUMANI_T_OPENALEX_MAILTO=

# Malware scanning of uploaded documents. Production refuses uploads until you
# choose. To scan with the bundled ClamAV, add malware-scan to COMPOSE_PROFILES
# and set clamd and tcp://clamav:3310 below; it needs about 1.5 GB more memory,
# and freshclam fetches signatures from database.clamav.net every two hours
# (ADR 0012). `none` uploads without scanning, and every document says so.
HUMANI_T_MALWARE_SCANNER=
HUMANI_T_CLAMD_ADDRESS=
HUMANI_T_CLAMAV_MEMORY=2g

# Optional services, comma-separated: local-model (Ollama), local-mail (Mailpit),
# malware-scan (ClamAV).
COMPOSE_PROFILES=

# API processes. Each holds up to 10 database connections.
HUMANI_T_API_WORKERS=2
HUMANI_T_LOG_LEVEL=INFO

# Where the secret files live. Keeping them outside the checkout, e.g.
# /etc/humani-t/secrets, means a stray `git clean` or copy of the folder cannot
# take them along.
HUMANI_T_SECRETS_DIR=./secrets
